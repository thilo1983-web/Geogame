{
  "name": "Geogame (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm install --legacy-peer-deps && npm install -g @expo/ngrok@4.1.3",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Metro Bundler",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  }
}
